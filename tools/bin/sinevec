#!/usr/bin/env bash
set -euo pipefail

# Portable CLI shim for the Sinevec project.
# Works in the dev shell and regular venvs.

# If a local venv exists, activate it (prefers project .venv)
if [ -z "${VIRTUAL_ENV-}" ] && [ -f ".venv/bin/activate" ]; then
  # shellcheck disable=SC1091
  source .venv/bin/activate
fi

# Ensure Python can import from src/ when not installed
export PYTHONPATH="$PWD/src:${PYTHONPATH-}"

# Invoke the Typer app directly with a nice program name
exec python - "$@" <<'PY'
from sinevec.cli import app
app(prog_name="sinevec")
PY
